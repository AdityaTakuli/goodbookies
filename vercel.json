{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/dist/client/favicon.ico"
    },
    {
      "src": "/favicon.png",
      "dest": "/dist/client/favicon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/render?path=$1"
    }
  ]
}
