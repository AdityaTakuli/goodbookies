{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/client/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/client/favicon.ico"
    },
    {
      "src": "/favicon.png",
      "dest": "/client/favicon.png"
    },
    {
      "src": "/api/mobile/(.*)",
      "dest": "/api/mobile/$1"
    },
    {
      "src": "/inventory/flags",
      "dest": "/api/inventory/flags"
    },
    {
      "src": "/inventory/clubs",
      "dest": "/api/inventory/clubs"
    },
    {
      "src": "/api/v1/assets/avatar-inventory",
      "dest": "/api/v1/assets/avatar-inventory"
    },
    {
      "src": "/(.*)",
      "dest": "/api/render?path=$1"
    }
  ]
}
